DATABASE_URL=postgresql://@localhost:5432/support_reply_assistant
AUTH_SECRET=replace-with-a-long-random-secret
SECRETS_ENCRYPTION_KEY=replace-with-32-byte-base64-key
APP_URL=http://localhost:3000
# Set true only when a trusted reverse proxy strips and rewrites forwarding headers.
TRUST_PROXY=false
# Optional: defaults to ./storage/users. Use persistent storage in production.
USER_STORAGE_DIR=./storage/users
