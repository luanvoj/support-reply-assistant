DATABASE_URL=postgresql://@localhost:5432/support_reply_assistant
AUTH_SECRET=replace-with-a-long-random-secret
SECRETS_ENCRYPTION_KEY=replace-with-32-byte-base64-key
APP_URL=http://localhost:3000
# Used only by scripts/seed-admin.sh. Defaults are for local development;
# set these explicitly through the deployment secret manager in production.
# ADMIN_EMAIL=admin@example.local
# ADMIN_USERNAME=admin
# ADMIN_FULL_NAME=System Administrator
# Set true only when a trusted reverse proxy strips and rewrites forwarding headers.
# Without it, the app deliberately skips per-IP buckets and uses global/identity/MFA-challenge limits.
TRUST_PROXY=false
# Optional: defaults to ./storage/users. Use persistent storage in production.
USER_STORAGE_DIR=./storage/users
